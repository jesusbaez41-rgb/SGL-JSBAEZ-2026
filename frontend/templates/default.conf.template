# Generado por envsubst desde templates/default.conf.template.
#
# FORCE_HTTPS=true  -> el puerto 80 redirige a 443 (producción).
# FORCE_HTTPS=false -> el puerto 80 sirve la SPA y la API (desarrollo local).
#
# Se usa 308 (no 301) para conservar el método y el cuerpo del POST.
map "${FORCE_HTTPS}" $sgl_force_https {
    default 0;
    "true" 1;
    "1" 1;
}

# HTTP: local sirve la aplicación; producción redirige a HTTPS.
server {
    listen 80;
    server_name _;

    add_header Cache-Control "no-store" always;

    if ($sgl_force_https) {
        return 308 https://$host$request_uri;
    }

    include /etc/nginx/sgl-locations.conf;
}

# HTTPS: sirve la SPA y hace proxy de /api hacia el backend interno.
server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/sgl.crt;
    ssl_certificate_key /etc/nginx/certs/sgl.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    include /etc/nginx/sgl-locations.conf;
}
