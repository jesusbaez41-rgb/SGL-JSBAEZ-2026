POSTGRES_DB=sgl
POSTGRES_USER=sgl_user
POSTGRES_PASSWORD=change_me
JWT_SECRET=change_me_long_random
JWT_EXPIRES=8h
SESSION_IDLE_MINUTES=30
AUTH_MAX_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
LDAP_URL=ldaps://dc.clockwork.local:636
LDAP_BIND_DN=CN=Administrator,CN=Users,DC=clockwork,DC=local
LDAP_BIND_PASSWORD=change_me
LDAP_SEARCH_BASE=DC=clockwork,DC=local
LDAP_USERS_DN=CN=Users,DC=clockwork,DC=local
LDAP_CA_CERT=/app/certs/samba-ca.pem
LDAP_TLS_SERVERNAME=dc.clockwork.local
LDAP_TLS_REJECT_UNAUTHORIZED=true
CORS_ORIGIN=*
# Local: HTTP permitido. Producción: FORCE_HTTPS=true y VITE_FORCE_HTTPS=true.
FORCE_HTTPS=false
VITE_FORCE_HTTPS=false
# HU-COM-03: bridge local que consulta MeshCentral
MESH_API_URL=http://host.docker.internal:4444
MESH_API_TOKEN=change_me_mesh_bridge
